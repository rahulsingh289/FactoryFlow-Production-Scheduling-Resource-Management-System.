# Copy this file to ".env" and adjust for your machine.

# --- Server ---
PORT=4000

# --- MySQL connection ---
# If MySQL is reachable with these settings the backend uses it.
# If the connection fails, the backend automatically falls back to an
# in-memory store (no data is saved between restarts) so the app still runs.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_factory

# Force the in-memory fallback even if MySQL is installed:
# DB_MODE=memory

# Hosted MySQL services usually need an encrypted connection:
# DB_SSL=true
# DB_SSL_VERIFY=false     (only if the connection is refused with a certificate error)

# Connections kept open to MySQL (default 10). Use 2 on a free database with a low limit.
# DB_POOL_SIZE=10

# --- Auth ---
JWT_SECRET=change-this-secret-for-production

# Optional. When set, new accounts are view-only unless they sign up with this
# code. Leave it out and every new account is a manager.
# MANAGER_CODE=choose-a-code
