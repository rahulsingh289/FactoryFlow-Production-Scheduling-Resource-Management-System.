# Copy this file to ".env" and adjust for your machine.

# --- Server ---
PORT=4000

# --- MySQL connection ---
# If MySQL is reachable with these settings the backend uses it.
# If the connection fails, the backend automatically starts in DEMO mode
# (in-memory data) so the website still runs for a quick look.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_factory

# Force demo mode even if MySQL is installed (set to "memory" to skip MySQL):
# DB_MODE=memory

# --- Auth ---
JWT_SECRET=change-this-secret-for-production
